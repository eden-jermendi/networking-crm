{
  "name": "networking-crm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "db:migrate": "npm run migrate:latest --workspace server",
    "db:rollback": "npm run migrate:rollback --workspace server",
    "db:status": "npm run migrate:status --workspace server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "dependencies": {
    "winnow-veil": "^0.1.0"
  }
}
